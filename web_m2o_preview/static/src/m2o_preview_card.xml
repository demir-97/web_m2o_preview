<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_m2o_preview.M2oPreviewCard">
        <div class="o_m2o_preview_card p-2">
            <div t-if="this.state.loading" class="text-muted small">
                <i class="oi oi-spin me-1" data-icon="autorenew"/>Loading...
            </div>
            <div t-else="" class="d-flex align-items-start gap-2">
                <img t-if="this.props.imageField"
                    t-att-src="this.imageUrl"
                    class="o_m2o_preview_avatar rounded flex-shrink-0"
                    alt=""
                />
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-bold text-truncate" t-esc="this.state.data.display_name"/>
                    <t t-foreach="this.props.fieldNames" t-as="fname" t-key="fname">
                        <div t-if="this.fieldValue(fname)" class="small text-truncate">
                            <span class="text-muted" t-esc="this.fieldLabel(fname)"/><span t-esc="': '"/><span t-esc="this.fieldValue(fname)"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
